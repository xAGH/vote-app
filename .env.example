# Puerto en que corre la app
PORT=3000

# Ejemplo local: http://localhost:3000
# Ejemplo con Cloudflare Tunnel: https://voto.midominio.com
APP_URL=http://localhost:3000

# Contraseña del panel admin
ADMIN_PASSWORD=admin123

# Secreto para las sesiones (mínimo 16 caracteres, obligatorio en producción)
SESSION_SECRET=cambia_esto_por_algo_secreto_y_largo

# Nombre y fecha del evento (la fecha es la que se usa para consultar
# asistencia en Pulse — formato AAAA-MM-DD)
EVENT_NAME=ShowRoom Proyectos Formativos ADSO
EVENT_DATE=2026-09-16

# --- Integración con Pulse (ver ~/code/pulse/docs/09-m2m-integrations.md) ---

# URL base de la API de Pulse (sin /integrations/attendance al final)
PULSE_API_URL=https://pulse.midominio.com

# Clave M2M configurada en Pulse (INTEGRATION_API_KEY del lado de Pulse)
PULSE_API_KEY=

# En true, no llama a Pulse: usa un roster de ejemplo para desarrollo.
PULSE_MOCK=true

# production habilita validaciones estrictas (SESSION_SECRET obligatorio,
# cookies "secure", etc.). Déjalo vacío o en "development" para el evento
# si no hay HTTPS todavía.
NODE_ENV=development
