<div class="credential" style="max-width:400px; margin:60px auto;">
  <span class="credential__clip" aria-hidden="true"></span>
  <h1 class="credential__title">Administración</h1>
  <p class="credential__lede">Configura el evento, sincroniza asistencia y consulta resultados.</p>

  <% if (formError) { %>
    <div class="alert alert--warn" role="alert">
      <svg class="icon"><use href="#icon-alert"/></svg>
      <span><%= formError %></span>
    </div>
  <% } %>

  <form method="post" action="/admin/ingresar">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label class="field__label" for="password">Contraseña</label>
      <input class="input" type="password" id="password" name="password" required autofocus>
    </div>
    <button class="btn btn--ink btn--block" type="submit">
      <svg class="icon"><use href="#icon-lock"/></svg>
      Entrar
    </button>
  </form>
</div>
