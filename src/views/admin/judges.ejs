<%- include('../partials/admin-nav') %>

<div class="page-head">
  <h1 class="page-head__title">Jurados</h1>
  <p class="page-head__desc">El PIN se muestra una sola vez al crear o regenerar. Entrégalo en persona.</p>
</div>

<div class="table-wrap" style="padding:22px; margin-bottom:24px;">
  <h2 style="font-size:0.95rem; font-weight:700; margin-bottom:14px;">Agregar jurado</h2>
  <form method="post" action="/admin/jurados" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
    <div class="field" style="margin-bottom:0; flex:1; min-width:220px;">
      <label class="field__label" for="name">Nombre</label>
      <input class="input" id="name" name="name" placeholder="Nombre del jurado" required>
    </div>
    <button class="btn btn--primary" type="submit"><svg class="icon"><use href="#icon-plus"/></svg>Agregar</button>
  </form>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Jurado</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% judges.forEach(function (j) { %>
        <tr style="opacity:<%= j.is_active ? '1' : '0.5' %>;">
          <td><strong><%= j.name %></strong></td>
          <td><span class="chip <%= j.is_active ? 'chip--done' : 'chip--pending' %>"><%= j.is_active ? 'Activo' : 'Inactivo' %></span></td>
          <td style="text-align:right; white-space:nowrap;">
            <form method="post" action="/admin/jurados/<%= j.id %>/regenerar-pin" style="display:inline;">
              <button class="btn btn--ghost btn--sm" type="submit">Nuevo PIN</button>
            </form>
            <form method="post" action="/admin/jurados/<%= j.id %>/estado" style="display:inline;">
              <input type="hidden" name="active" value="<%= j.is_active ? '0' : '1' %>">
              <button class="btn btn--ghost btn--sm" type="submit"><svg class="icon"><use href="#icon-<%= j.is_active ? 'x' : 'check' %>"/></svg></button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!judges.length) { %>
        <tr><td colspan="3" class="empty-state">Todavía no hay jurados.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
