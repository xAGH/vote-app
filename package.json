{
  "name": "showroom-vote",
  "version": "1.0.0",
  "private": true,
  "description": "Votación de aprendices y calificación de jurados para el ShowRoom de proyectos formativos SENA",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:demo": "node src/db/seed.js",
    "db:migrate": "node -e \"require('./src/db').init()\""
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1"
  }
}
